# Kopiera till .env.local och fyll i vid behov.

# Solana RPC för read-only (saldokoll av $CUBIT när mint är satt). Standard: publika mainnet-RPC:n.
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com

# true = nätverkspanelerna (avgifter, utbetalningar, topplista, ledger) simuleras i webbläsaren.
# Sätt till false först när den riktiga backend-strömmen är inkopplad (TODO(backend)).
VITE_DEMO=true
